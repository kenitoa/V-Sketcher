{
  "name": "2dsketcher",
  "productName": "2DSketcher",
  "version": "0.5.0",
  "private": true,
  "description": "Local virtual character creation studio — foundation preview",
  "author": "2DSketcher contributors",
  "main": "dist/electron/apps/desktop/main.js",
  "engines": {
    "node": "24.22.3",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "build": "node scripts/build.mjs --mode=release",
    "build:test": "node scripts/build.mjs --mode=test",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs",
    "worker:build": "node scripts/worker-build.mjs",
    "make": "node scripts/make.mjs",
    "package:check": "node scripts/package-check.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.23.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron/asar": "4.3.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "electron": "45.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
