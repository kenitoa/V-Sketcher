* text=auto eol=lf
# Frozen evidence is byte-addressed; never normalize its line endings.
/experiments/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/evidence/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.png -text
*.jpg -text
*.jpeg -text
*.gif -text
*.apng -text
*.mkv -text
*.inp -text
*.pdf -text
*.task -text
*.zip -text
